__pycache__/
*.pyc

# Training/calibration data — lives in github.com/Real-Coltix/Datasets, not here.
# datasets/ is ~15G; a calib dir is hundreds of MB of derived .npy tensors
# (calib/ 353M, calib_v26/ 236M), regenerated by build_calib.py — deterministic
# for a given --seed — once datasets/ is present. Glob, not a literal name:
# every model gets its own calib dir, and one `git add -A` on an unignored one
# would commit a quarter-gig of derived tensors.
datasets/
calib*/

# local venvs
.venv/
